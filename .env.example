# Used by docker-compose.yml. Copy to .env next to docker-compose.yml. Never commit the real file.

# Public address of the app. With the production override this is one domain for web + API.
DOMAIN=localhost
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# Clerk (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_ISSUER=https://your-app-12.clerk.accounts.dev
CLERK_WEBHOOK_SECRET=

# Gemini (free key: https://aistudio.google.com/apikey): chat, embeddings and live voice
GEMINI_API_KEY=

# Billing
APP_ENV=production
BILLING_DEV_MODE=false
BILLING_WEBHOOK_SECRET=
