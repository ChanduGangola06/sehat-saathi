# Copy to backend/.env and fill in. Never commit the real file.

# ---- Server ----
PORT=8080
APP_ENV=development            # set to "production" when deployed (turns on HSTS and strict checks)
FRONTEND_ORIGIN=http://localhost:3000   # exact origin of the web app (CORS, WebSocket origin check, Clerk "azp")
DATABASE_URL=sqlite://healthbot.db?mode=rwc
KNOWLEDGE_DIR=knowledge

# ---- Auth (Clerk): Dashboard -> API keys ----
CLERK_ISSUER=https://your-app-12.clerk.accounts.dev   # your Frontend API URL
CLERK_SECRET_KEY=sk_test_xxx                           # lets the server delete Clerk users on account deletion
CLERK_WEBHOOK_SECRET=whsec_xxx                         # Dashboard -> Webhooks -> endpoint /api/clerk/webhook, event user.deleted

# ---- AI ----
# Text chat tries providers in this order and falls back to the next on failure.
AI_PROVIDERS=gemini,ollama
GEMINI_API_KEY=                                        # free key: https://aistudio.google.com/apikey
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001
OLLAMA_BASE_URL=http://localhost:11434/v1              # local fallback: `ollama pull llama3.1 nomic-embed-text`
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text
# Live voice (speech-to-speech) uses the same GEMINI_API_KEY.
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
GEMINI_LIVE_VOICE=Aoede
# Optional extra provider: add "openai" to AI_PROVIDERS and set OPENAI_API_KEY (+ CHAT_MODEL, EMBED_MODEL).
# OPENAI_API_KEY=

# ---- Limits and billing ----
AI_RATE_PER_MIN=20             # per-user cap on AI requests
FREE_DAILY_TOKENS=1000
BILLING_DEV_MODE=false         # true lets anyone "pay" for free. Local testing only; refused when APP_ENV=production
BILLING_WEBHOOK_SECRET=        # shared secret (16+ chars) your payment provider signs webhooks with
